# /etc/systemd/system/hr-rag.service
[Unit]
Description=HR Policy RAG API (FastAPI + LangGraph)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/hr-policy-rag/backend
EnvironmentFile=/opt/hr-policy-rag/backend/.env
# one worker: FAISS index lives in memory
ExecStart=/opt/hr-policy-rag/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
